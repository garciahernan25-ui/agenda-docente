{
  "name": "agenda-docente",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --tsconfig tsconfig.json scripts/seed.ts",
    "pdf:prueba": "tsx --tsconfig tsconfig.json scripts/pdf-prueba.ts",
    "clave": "tsx scripts/clave.mts",
    "db:migrar": "tsx --tsconfig tsconfig.json scripts/migrar.ts",
    "db:migrar:turso": "tsx --tsconfig tsconfig.json scripts/migrar.ts --turso"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "docx": "^9.5.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
